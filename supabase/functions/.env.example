# Edge Function secrets. Local: copy to supabase/functions/.env
# Hosted: npx supabase@latest secrets set --env-file supabase/functions/.env
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# BTCPay Server (testnet store)
BTCPAY_URL=https://testnet.example-btcpay.com
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=
BTCPAY_PAYMENT_METHOD=BTC-CHAIN

# Sumsub (sandbox credentials while testing)
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_LEVEL_NAME=basic-kyc-level
SUMSUB_WEBHOOK_SECRET=

# AML screening: "none" is refused when APP_ENV=production
AML_PROVIDER=none
CHAINALYSIS_API_KEY=
