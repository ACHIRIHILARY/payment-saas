# Copy to apps/web/.env.local and apps/admin/.env.local
# Values come from `npx supabase start` (local) or your Supabase project settings.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-anon-key
# Tenant slug new sign-ups are attached to (white-label deployments set their own).
VITE_TENANT_SLUG=default
